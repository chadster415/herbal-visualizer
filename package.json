{
  "name": "herbal-visualizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "./node_modules/.bin/next dev",
    "dev-db": "supabase start",
    "stop-db": "supabase stop",
    "reset-db": "supabase db reset",
    "snapshot-db": "supabase db dump --local --data-only --schema herbal -f supabase/migrations/008_current_data_snapshot.sql",
    "ingest": "ts-node scripts/ingest-secondary-actions.ts",
    "build": "./node_modules/.bin/next build",
    "start": "./node_modules/.bin/next start",
    "lint": "./node_modules/.bin/next lint"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@marsidev/react-turnstile": "^1.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
